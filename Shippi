

const SHIP_IP = "192.168.100.40";
const STEER_PORT = 2009;
const COMM_PORT = 2011;
const HOLD_PORT = 2012;

const BUY_STATION = "Azura Station";
const SELL_STATION = "Core Station"; 
const TARGET_STATION = "Vesta Station";

const MIN_CREDITS = 60;
const TARGET_IRON = 12;

function url(port, path) {
  return `http://${SHIP_IP}:${port}${path}`;
}

async function getJson(port, path) {
  const res = await fetch(url(port, path));
  return res.json();
}

async function postJson(port, path, body) {
  const res = await fetch(url(port, path), {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return res.json();
}

const setTarget = (target) => postJson(STEER_PORT, "/set_target", { target });
const getStationsInReach = () => getJson(COMM_PORT, "/stations_in_reach");
const getHold = () => getJson(HOLD_PORT, "/hold");
const buyIron = (station, amount) =>
  postJson(COMM_PORT, "/buy", { station, what: "IRON", amount });
const sellIron = (station, amount) =>
  postJson(COMM_PORT, "/sell", { station, what: "IRON", amount });

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function flyTo(station) {
  console.log(`Fliege zu ${station} ...`);
  await setTarget(station);
  while (true) {
    await sleep(2000);
    const { stations } = await getStationsInReach();
    if (stations[station]) {
      console.log(`Angekommen bei ${station}.`);
      return;
    }
  }
}

async function main() {
  let hold = await getHold();
  while (hold.hold.credits < MIN_CREDITS) {
    console.log(`Credits: ${hold.hold.credits}/${MIN_CREDITS}`);

    await flyTo(BUY_STATION);
    console.log("Kaufe 1x IRON ...", await buyIron(BUY_STATION, 1));

    await flyTo(SELL_STATION);
    console.log("Verkaufe 1x IRON ...", await sellIron(SELL_STATION, 1));

    hold = await getHold();
  }
  console.log(`${MIN_CREDITS}+ Credits erreicht (${hold.hold.credits}).`);

  while ((hold.hold.resources.IRON || 0) < TARGET_IRON) {
    console.log(`Eisen: ${hold.hold.resources.IRON || 0}/${TARGET_IRON}`);

    await flyTo(BUY_STATION);
    console.log("Kaufe 1x IRON ...", await buyIron(BUY_STATION, 1));

    hold = await getHold();
  }
  console.log(`${TARGET_IRON} Eisen erreicht.`);

  await flyTo(TARGET_STATION);
  await setTarget("stop");
  console.log("Bei Vesta Station angedockt. Fertig!");
}

main();
